#!/usr/bin/env python3
"""omaperi — one control surface for every peripheral.

Every vendor tool worth using already describes its own device: headsetcontrol
reports a capability list, openrazer answers has(), OpenRGB lists modes and
zones, v4l2-ctl prints types and ranges. So omaperi owns no device database.
Each adapter translates one of those tools into the same capability document,
and the Omarchy panel renders that document generically.

The consequence worth protecting: a new device is a new *adapter*, never new
QML. If a device needs a tool that isn't installed, its adapter reports itself
unavailable and disappears from the panel instead of erroring.

  omaperi status              capability document for everything present
  omaperi apply ID KEY VALUE  set one control, print the refreshed document
  omaperi backends            which adapters are live, and why not
  omaperi effects             write animation frames until none are wanted
                              (started automatically; exits on its own)

Document schema (version 1):

  {"schema": 1,
   "devices": [{"id", "name", "kind", "backend", "battery", "controls": [...]}],
   "backends": [{"name", "available", "reason"}]}

Control types: range | enum | toggle | action | readout | color
"""

import fcntl
import json
import math
import os
import re
import shutil
import socket
import struct
import subprocess
import sys
import time

SCHEMA = 1
STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "omaperi"
)
CACHE = os.path.join(STATE_DIR, "cache.json")
LOCK = os.path.join(STATE_DIR, "poll.lock")
STATE = os.path.join(STATE_DIR, "state.json")
CACHE_TTL = float(os.environ.get("OMAPERI_CACHE_TTL", "10"))


def run(cmd, timeout=15):
    """Return (rc, stdout, stderr); rc 127 when the binary is missing."""
    try:
        p = subprocess.run(
            cmd, capture_output=True, text=True, timeout=timeout, check=False
        )
        return p.returncode, p.stdout, p.stderr
    except FileNotFoundError:
        return 127, "", "not found"
    except subprocess.TimeoutExpired:
        return 124, "", "timed out"


def load_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except Exception:
        return {}


def save_state(state):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f)
    os.replace(tmp, STATE)


def remembered(device_id, key, fallback=None):
    """Last value we wrote for a write-only control.

    Several of these tools set without being able to read back (headsetcontrol
    sidetone is the clearest case), so the panel would otherwise show a slider
    that never reflects reality. Remember what we sent.
    """
    return load_state().get(device_id, {}).get(key, fallback)


def remember(device_id, key, value):
    state = load_state()
    state.setdefault(device_id, {})[key] = value
    save_state(state)


def remember_global(key, value):
    state = load_state()
    state[key] = value
    save_state(state)


def control(key, label, ctype, **kw):
    c = {"key": key, "label": label, "type": ctype}
    c.update({k: v for k, v in kw.items() if v is not None})
    return c


# --------------------------------------------------------------------------
# headsetcontrol — headsets
# --------------------------------------------------------------------------

# Capability -> control. headsetcontrol names its own capabilities, so this is
# a flag table rather than a per-model table: any headset it supports shows up
# with exactly the controls it actually has.
HS_RANGES = {
    "CAP_SIDETONE": ("sidetone", "Sidetone", "-s", 0, 128, None),
    "CAP_INACTIVE_TIME": ("inactive_time", "Auto-off", "-i", 0, 90, "min"),
    "CAP_MICROPHONE_VOLUME": ("mic_volume", "Mic volume", "--microphone-volume", 0, 128, None),
    "CAP_MICROPHONE_MUTE_LED_BRIGHTNESS": (
        "mic_led", "Mic mute LED", "--microphone-mute-led-brightness", 0, 3, None),
    "CAP_BT_CALL_VOLUME": ("bt_call_volume", "BT call volume", "--bt-call-volume", 0, 100, None),
}
# The device reports its real gain limits over HID, but headsetcontrol only
# exposes them through its C library -- the CLI never prints them, upstream
# 4.1.0 included. Out-of-range values are clamped silently rather than
# refused (a 30 dB band is accepted without error), so a conservative window
# is safe: the ends may simply do nothing on a narrower device.
EQ_GAIN_MIN = -12
EQ_GAIN_MAX = 12

HS_TOGGLES = {
    "CAP_LIGHTS": ("lights", "Lights", "-l"),
    "CAP_ROTATE_TO_MUTE": ("rotate_to_mute", "Mute when boom raised", "-r"),
    "CAP_VOICE_PROMPTS": ("voice_prompts", "Voice prompts", "-v"),
    "CAP_VOLUME_LIMITER": ("volume_limiter", "Volume limiter", "--volume-limiter"),
    "CAP_BT_WHEN_POWERED_ON": ("bt_on_power", "Bluetooth on power-on", "--bt-when-powered-on"),
}


def hs_available():
    if not shutil.which("headsetcontrol"):
        return False, "headsetcontrol not installed"
    return True, None


HS_STATIC_KEY = "_headset_static"


def hs_devices():
    """Enumerate headsets without paying for a powered-off one every poll.

    `headsetcontrol -o json` blocks for 4-5 seconds when the headset is off --
    the battery read is what waits. Everything else it returns (name, ids,
    capabilities, EQ presets) is fixed for a given headset, so remember it and
    fall back to it on timeout. A powered-off headset then costs the timeout
    once, not on every poll.
    """
    known = load_state().get(HS_STATIC_KEY)
    rc, out, _ = run(["headsetcontrol", "-o", "json"], timeout=2 if known else 12)

    if rc == 0 and out.strip():
        try:
            doc = json.loads(out)
        except ValueError:
            doc = None
        if doc and doc.get("devices"):
            statics = []
            for d in doc["devices"]:
                keep = dict(d)
                keep.pop("battery", None)
                statics.append(keep)
            remember_global(HS_STATIC_KEY, statics)
            return [hs_device(d) for d in doc["devices"]]

    if known:
        offline = {"status": "BATTERY_UNAVAILABLE", "level": -1}
        return [hs_device(dict(d, battery=offline)) for d in known]
    return []


def hs_device(d):
    dev_id = "headset:%s:%s" % (
        str(d.get("id_vendor", "")).replace("0x", ""),
        str(d.get("id_product", "")).replace("0x", ""),
    )
    caps = d.get("capabilities", [])
    controls = []

    for cap, (key, label, _flag, lo, hi, unit) in HS_RANGES.items():
        if cap in caps:
            controls.append(
                control(key, label, "range", min=lo, max=hi, step=1, unit=unit,
                        value=remembered(dev_id, key, lo))
            )

    presets = d.get("equalizer_presets") or {}
    if "CAP_EQUALIZER_PRESET" in caps and presets:
        # -p takes the preset's index, so carry the index as the value and the
        # name as the label.
        options = [{"value": i, "label": n} for i, n in enumerate(presets)]
        controls.append(
            control("eq_preset", "Equalizer", "enum", options=options,
                    value=remembered(dev_id, "eq_preset", 0))
        )

    if "CAP_NOISE_FILTER" in caps:
        controls.append(
            control("noise_filter", "Mic noise filter", "enum",
                    options=[{"value": 0, "label": "Off"},
                             {"value": 1, "label": "Low"},
                             {"value": 2, "label": "High"}],
                    value=remembered(dev_id, "noise_filter", 0))
        )

    # The custom curve behind the presets. Band count comes from the presets
    # themselves, which are the same length as the device's EQ.
    bands = hs_band_count(d)
    if "CAP_EQUALIZER" in caps and bands:
        curve = hs_curve(dev_id, bands)
        for i in range(bands):
            controls.append(
                control("eq_band_%d" % i, "Band %d" % (i + 1), "range",
                        min=EQ_GAIN_MIN, max=EQ_GAIN_MAX, step=1, unit="dB",
                        value=curve[i])
            )

    for cap, (key, label, _flag) in HS_TOGGLES.items():
        if cap in caps:
            controls.append(
                control(key, label, "toggle", value=bool(remembered(dev_id, key, False)))
            )

    if "CAP_NOTIFICATION_SOUND" in caps:
        controls.append(control("notification_sound", "Play test sound", "action"))

    chatmix = d.get("chatmix")
    if "CAP_CHATMIX_STATUS" in caps and isinstance(chatmix, int) and chatmix >= 0:
        controls.append(control("chatmix", "Chat/game mix", "readout", value=chatmix))

    battery = None
    bat = d.get("battery") or {}
    if bat.get("status") in ("BATTERY_AVAILABLE", "BATTERY_CHARGING"):
        battery = {
            "level": bat.get("level"),
            "charging": bat.get("status") == "BATTERY_CHARGING",
        }

    return {
        "id": dev_id,
        "name": d.get("device") or d.get("product") or "Headset",
        "kind": "headset",
        "backend": "headsetcontrol",
        "battery": battery,
        "controls": controls,
        # A headset that is off still enumerates over its dongle; say so rather
        # than showing controls that will silently do nothing.
        "note": None if battery else "Powered off or out of range",
    }


def hs_band_count(d):
    presets = d.get("equalizer_presets") or {}
    for values in presets.values():
        if isinstance(values, list) and values:
            return len(values)
    return 0


def hs_curve(dev_id, bands):
    """The last curve omaperi sent, padded to the band count.

    headsetcontrol cannot read the active curve back, so this is what we last
    wrote -- including the curve behind whichever preset was picked.
    """
    curve = remembered(dev_id, "eq_curve", None) or []
    curve = [int(v) for v in curve][:bands]
    return curve + [0] * (bands - len(curve))


def hs_preset_curve(dev, index):
    """The band values of a built-in preset, from the cached description."""
    for static in load_state().get(HS_STATIC_KEY) or []:
        presets = static.get("equalizer_presets") or {}
        values = list(presets.values())
        if 0 <= index < len(values):
            return [int(round(v)) for v in values[index]]
    return None


def hs_apply(dev, key, value):
    bands = len([c for c in dev.get("controls", []) if c["key"].startswith("eq_band_")])

    if key.startswith("eq_band_") and bands:
        index = int(key.rsplit("_", 1)[1])
        curve = hs_curve(dev["id"], bands)
        curve[index] = int(value)
        rc, _out, err = run(["headsetcontrol", "-e",
                             ",".join(str(v) for v in curve)])
        if rc != 0:
            raise SystemExit("headsetcontrol -e failed: %s" % err.strip())
        remember(dev["id"], "eq_curve", curve)
        return

    flag = None
    for cap, (k, _l, f, _lo, _hi, _u) in HS_RANGES.items():
        if k == key:
            flag = f
    for cap, (k, _l, f) in HS_TOGGLES.items():
        if k == key:
            flag = f
            value = 1 if str(value).lower() in ("1", "true", "on", "yes") else 0
    if key == "noise_filter":
        flag = "--noise-filter"
    if key == "eq_preset":
        flag = "-p"
    if key == "notification_sound":
        flag, value = "-n", 1
    if flag is None:
        raise SystemExit("headsetcontrol: no such control %r" % key)

    rc, _out, err = run(["headsetcontrol", flag, str(value)])
    if rc != 0:
        raise SystemExit("headsetcontrol %s %s failed: %s" % (flag, value, err.strip()))
    if key in ("lights", "rotate_to_mute", "voice_prompts",
               "volume_limiter", "bt_on_power"):
        remember(dev["id"], key, bool(int(value)))
    elif key != "notification_sound":
        remember(dev["id"], key, int(value))
        # Picking a preset moves the real curve, so keep the band sliders
        # showing what the headset is actually doing.
        if key == "eq_preset":
            curve = hs_preset_curve(dev, int(value))
            if curve:
                remember(dev["id"], "eq_curve", curve)


# --------------------------------------------------------------------------
# openrazer — Razer mice and keyboards
# --------------------------------------------------------------------------


def razer_available():
    try:
        import openrazer.client  # noqa: F401
    except ImportError:
        return False, "python-openrazer not installed"
    rc, _o, _e = run(["systemctl", "--user", "is-active", "openrazer-daemon"], timeout=5)
    if rc != 0:
        return False, "openrazer-daemon not running"
    return True, None


def razer_devices():
    try:
        from openrazer.client import DeviceManager
    except ImportError:
        return []
    try:
        devices = DeviceManager().devices
    except Exception:
        return []
    return [razer_device(d) for d in devices]


def razer_device(d):
    dev_id = "razer:%s" % d.serial
    controls = []

    if d.has("dpi"):
        try:
            current = d.dpi[0] or None      # 0 means asleep, same as the battery
        except Exception:
            current = None
        # The onboard stages, so the panel offers the same presets the mouse's
        # own DPI button cycles through.
        stages = razer_dpi_stages(d)
        if stages:
            controls.append(
                control("dpi_stage", "DPI preset", "enum", unit="DPI",
                        options=[{"value": v, "label": str(v)} for v in stages],
                        value=current if current in stages else None)
            )
        # editable: a 100-30000 slider cannot land on an exact figure, and DPI
        # is a number people know and type.
        controls.append(
            control("dpi", "DPI", "range", min=100, max=getattr(d, "max_dpi", 16000),
                    step=50, value=current, editable=True)
        )

    if d.has("poll_rate"):
        rates = getattr(d, "supported_poll_rates", None) or [125, 500, 1000]
        controls.append(
            control("poll_rate", "Polling rate", "enum", unit="Hz",
                    options=[{"value": r, "label": "%d Hz" % r} for r in rates],
                    value=getattr(d, "poll_rate", None))
        )

    if d.has("brightness"):
        try:
            controls.append(
                control("brightness", "Brightness", "range", min=0, max=100, step=1,
                        value=int(d.brightness))
            )
        except Exception:
            pass

    effects = razer_effects(d)
    if effects:
        controls.append(
            control("effect", "Lighting", "enum",
                    options=[{"value": e, "label": e.title()} for e in effects],
                    value=remembered(dev_id, "effect"))
        )
        controls.append(
            control("color", "Colour", "color", value=remembered(dev_id, "color", "#00ff88"))
        )

    try:
        idle_seconds = d.get_idle_time()
        controls.append(
            control("idle_time", "Sleep after", "range", min=1, max=15, step=1,
                    unit="min", value=max(1, int(idle_seconds) // 60))
        )
    except Exception:
        pass

    battery = None
    if d.has("battery"):
        try:
            level = round(d.battery_level)
            # This driver reports 0 when the dongle is awake but the mouse is
            # not -- asleep or switched off. A genuinely flat battery would
            # have passed through 1% first, so 0 means "no reading", and
            # showing it as 0% fires a false low-battery warning.
            battery = {"level": level, "charging": bool(d.is_charging)} if level > 0 else None
        except Exception:
            battery = None

    notes = []
    if d.has("battery") and battery is None:
        notes.append("Asleep or powered off")
    if not effects:
        # True for anything behind the HyperPolling dongle: openrazer exposes
        # battery/DPI/polling but no lighting endpoints at all.
        notes.append("No lighting exposed by openrazer for this device")
    note = " \u00b7 ".join(notes) or None

    return {
        "id": dev_id,
        "name": d.name,
        "kind": d.type if d.type in ("mouse", "keyboard", "headset") else "other",
        "backend": "openrazer",
        "battery": battery,
        "controls": controls,
        "note": note,
    }


def razer_dpi_stages(d):
    """The X values of the mouse's onboard DPI stages, in order.

    openrazer returns (active_index, [(x, y), ...]). The index base is not
    documented consistently across models, so omaperi never writes it back --
    picking a preset just sets the DPI to that stage's value, which every
    model handles the same way.
    """
    try:
        if not d.has("dpi_stages"):
            return []
        _active, stages = d.dpi_stages
        return [int(x) for x, _y in stages]
    except Exception:
        return []


def razer_effects(d):
    """Effects this device actually advertises, cheapest capability first."""
    candidates = [
        ("static", "lighting_static"),
        ("breath_single", "lighting_breath_single"),
        ("spectrum", "lighting_spectrum"),
        ("wave", "lighting_wave"),
        ("reactive", "lighting_reactive"),
    ]
    out = []
    for name, cap in candidates:
        try:
            if d.has(cap):
                out.append(name)
        except Exception:
            pass
    return out


def razer_asleep(d):
    """A sleeping Razer device reports battery 0 (see razer_device).

    It also accepts writes over its dongle and drops them: setting .dpi raises
    nothing and the value never lands. Callers must refuse rather than report
    success for a change that did not happen.
    """
    try:
        return bool(d.has("battery")) and round(d.battery_level) == 0
    except Exception:
        return False


def razer_apply(dev, key, value):
    from openrazer.client import DeviceManager

    serial = dev["id"].split(":", 1)[1]
    target = None
    for d in DeviceManager().devices:
        if d.serial == serial:
            target = d
            break
    if target is None:
        raise SystemExit("openrazer: device %s is gone" % serial)
    if razer_asleep(target):
        raise SystemExit("%s is asleep -- wake it and try again" % dev["name"])

    if key in ("dpi", "dpi_stage"):
        target.dpi = (int(value), int(value))
    elif key == "poll_rate":
        target.poll_rate = int(value)
    elif key == "brightness":
        target.brightness = float(value)
    elif key == "idle_time":
        target.set_idle_time(int(value) * 60)
    elif key in ("effect", "color"):
        razer_apply_lighting(target, dev["id"], key, value)
    else:
        raise SystemExit("openrazer: no such control %r" % key)


def razer_apply_lighting(target, dev_id, key, value):
    remember(dev_id, key, value)
    effect = remembered(dev_id, "effect") or "static"
    rgb = hex_to_rgb(remembered(dev_id, "color", "#00ff88"))
    fx = target.fx
    if effect == "static":
        fx.static(*rgb)
    elif effect == "breath_single":
        fx.breath_single(*rgb)
    elif effect == "spectrum":
        fx.spectrum()
    elif effect == "wave":
        fx.wave(1)
    elif effect == "reactive":
        fx.reactive(*rgb, 2)


def hex_to_rgb(value):
    value = (value or "#000000").lstrip("#")
    if len(value) != 6:
        return (0, 0, 0)
    return tuple(int(value[i:i + 2], 16) for i in (0, 2, 4))


# --------------------------------------------------------------------------
# OpenRGB SDK client (protocol 0)
# --------------------------------------------------------------------------

# Protocol 0 on purpose: every packet omaperi needs exists there, and asking
# for controller data with an empty payload makes the server answer in the
# protocol-0 layout, so none of the version-gated fields have to be parsed and
# this cannot drift when the server is upgraded.

MAGIC = b"ORGB"
HEADER = struct.Struct("<4sIII")

REQUEST_CONTROLLER_COUNT = 0
REQUEST_CONTROLLER_DATA = 1
SET_CLIENT_NAME = 50
RESIZE_ZONE = 1000
UPDATE_ZONE_LEDS = 1051
SET_CUSTOM_MODE = 1100


class Reader:
    """Little-endian cursor over the controller data block."""

    def __init__(self, data):
        self.data = data
        self.at = 0

    def take(self, n):
        chunk = self.data[self.at:self.at + n]
        if len(chunk) != n:
            raise ValueError("truncated at %d (wanted %d)" % (self.at, n))
        self.at += n
        return chunk

    def u16(self):
        return struct.unpack_from("<H", self.take(2))[0]

    def u32(self):
        return struct.unpack_from("<I", self.take(4))[0]

    def i32(self):
        return struct.unpack_from("<i", self.take(4))[0]

    def text(self):
        # Length includes the null terminator.
        length = self.u16()
        return self.take(length).split(b"\0", 1)[0].decode("utf-8", "replace")


class OpenRGB:
    def __init__(self, host="127.0.0.1", port=6742, timeout=2.0):
        self.sock = socket.create_connection((host, port), timeout=timeout)
        self.sock.settimeout(timeout)
        self._send(0, SET_CLIENT_NAME, b"omaperi\0")

    def close(self):
        try:
            self.sock.close()
        except OSError:
            pass

    def __enter__(self):
        return self

    def __exit__(self, *_exc):
        self.close()

    def _send(self, dev, pkt, payload=b""):
        self.sock.sendall(HEADER.pack(MAGIC, dev, pkt, len(payload)) + payload)

    def _recv(self, n):
        out = b""
        while len(out) < n:
            chunk = self.sock.recv(n - len(out))
            if not chunk:
                raise ConnectionError("server closed the connection")
            out += chunk
        return out

    def _reply(self, want_pkt):
        while True:
            magic, dev, pkt, size = HEADER.unpack(self._recv(HEADER.size))
            if magic != MAGIC:
                raise ValueError("not an OpenRGB packet: %r" % magic)
            body = self._recv(size) if size else b""
            if pkt == want_pkt:
                return dev, body
            # Unsolicited server notifications (device list updated, etc.)

    def controller_count(self):
        self._send(0, REQUEST_CONTROLLER_COUNT)
        _dev, body = self._reply(REQUEST_CONTROLLER_COUNT)
        return struct.unpack_from("<I", body)[0]

    def controller(self, index):
        self._send(index, REQUEST_CONTROLLER_DATA)   # empty body => protocol 0
        _dev, body = self._reply(REQUEST_CONTROLLER_DATA)
        return self._parse_controller(body)

    @staticmethod
    def _parse_controller(body):
        r = Reader(body)
        r.u32()                       # data_size, already framed by the header
        dev = {"type": r.i32(), "name": r.text(), "description": r.text(),
               "version": r.text(), "serial": r.text(), "location": r.text()}

        modes = []
        num_modes = r.u16()
        dev["active_mode"] = r.i32()
        for _ in range(num_modes):
            mode = {"name": r.text(), "value": r.i32(), "flags": r.u32(),
                    "speed_min": r.u32(), "speed_max": r.u32(),
                    "colors_min": r.u32(), "colors_max": r.u32(),
                    "speed": r.u32(), "direction": r.u32(),
                    "color_mode": r.u32()}
            mode["colors"] = [r.u32() for _ in range(r.u16())]
            modes.append(mode)
        dev["modes"] = modes

        zones = []
        for _ in range(r.u16()):
            zone = {"name": r.text(), "type": r.i32(), "leds_min": r.u32(),
                    "leds_max": r.u32(), "leds_count": r.u32()}
            r.take(r.u16())           # matrix map, unused
            zones.append(zone)
        dev["zones"] = zones

        dev["leds"] = [{"name": r.text(), "value": r.u32()} for _ in range(r.u16())]
        dev["colors"] = [r.u32() for _ in range(r.u16())]
        return dev

    def resize_zone(self, index, zone_idx, size):
        self._send(index, RESIZE_ZONE, struct.pack("<ii", zone_idx, size))

    def set_custom_mode(self, index):
        self._send(index, SET_CUSTOM_MODE)

    def update_zone_leds(self, index, zone_idx, colors):
        body = struct.pack("<IH", zone_idx, len(colors))
        body += b"".join(struct.pack("<I", c) for c in colors)
        self._send(index, UPDATE_ZONE_LEDS, struct.pack("<I", len(body) + 4) + body)


def rgb(r, g, b):
    """OpenRGB packs colour as 0x00BBGGRR."""
    return (r & 0xFF) | ((g & 0xFF) << 8) | ((b & 0xFF) << 16)


def unrgb(value):
    return (value & 0xFF, (value >> 8) & 0xFF, (value >> 16) & 0xFF)


# --------------------------------------------------------------------------
# software effects
# --------------------------------------------------------------------------

# Neither of the controllers here offers a firmware effect -- OpenRGB reports
# a single "Direct" mode with no speed range -- so anything animated has to be
# driven by writing frames. That is what the daemon below does.

EFFECTS = ["static", "breathing", "spectrum", "rainbow"]
EFFECT_LABELS = {"static": "Static", "breathing": "Breathing",
                 "spectrum": "Spectrum", "rainbow": "Rainbow"}
EFFECT_LOCK = os.path.join(STATE_DIR, "effects.lock")
EFFECT_TICK = 0.05                      # 20 frames a second is plenty here

# A rainbow spans this many LEDs before repeating, rather than being stretched
# over the zone: zones are sized to the channel maximum, which is usually far
# longer than the strip actually plugged in, so stretching would show only a
# sliver of the spectrum.
RAINBOW_PERIOD = 24


def hsv_rgb(h, sat, val):
    """(r, g, b) 0-255 from degrees/0-1/0-1."""
    c = val * sat
    x = c * (1 - abs(((h / 60.0) % 2) - 1))
    m = val - c
    r, g, b = [(c, x, 0), (x, c, 0), (0, c, x),
               (0, x, c), (x, 0, c), (c, 0, x)][int(h // 60) % 6]
    return (int(round((r + m) * 255)), int(round((g + m) * 255)),
            int(round((b + m) * 255)))


def effect_jobs():
    """Every zone currently running a non-static effect."""
    jobs = []
    for dev_id, values in load_state().items():
        if not dev_id.startswith("openrgb:") or not isinstance(values, dict):
            continue
        index = int(dev_id.split(":", 1)[1])
        for key, effect in values.items():
            if not key.endswith("_effect") or effect == "static":
                continue
            if effect not in EFFECTS:
                continue
            zone = int(key[4:key.index("_")])
            jobs.append({
                "index": index,
                "zone": zone,
                "effect": effect,
                "speed": int(values.get(key.replace("_effect", "_speed"), 50)),
                "base": hex_to_rgb(values.get(key.replace("_effect", "_color"),
                                              "#00ff88")),
            })
    return jobs


def effect_frame(job, count, phase):
    effect, base = job["effect"], job["base"]
    if effect == "breathing":
        # Never fully dark: a strip that blinks out reads as broken.
        k = 0.12 + 0.88 * (math.sin(phase * 2 * math.pi) + 1) / 2
        return [rgb(*[int(c * k) for c in base])] * count
    if effect == "spectrum":
        return [rgb(*hsv_rgb((phase * 360) % 360, 1.0, 1.0))] * count
    if effect == "rainbow":
        step = 360.0 / RAINBOW_PERIOD
        return [rgb(*hsv_rgb((phase * 360 + i * step) % 360, 1.0, 1.0))
                for i in range(count)]
    return [rgb(*base)] * count


def effects_running():
    """True when another process holds the effect lock."""
    try:
        with open(EFFECT_LOCK, "a") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                return True
            fcntl.flock(lock, fcntl.LOCK_UN)
    except OSError:
        pass
    return False


def ensure_effects_daemon():
    """Start the frame writer if an effect needs it and none is running."""
    if not effect_jobs() or effects_running():
        return
    try:
        subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "effects"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL, start_new_session=True,
        )
    except Exception:
        pass


def run_effects():
    """Write frames until nothing wants them any more, then exit.

    Self-limiting on purpose: no unit to enable, and no process left running
    once everything is back to static.
    """
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(EFFECT_LOCK, "a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return 0                     # another writer already has it

        client = None
        primed = set()
        phase = 0.0
        idle = 0.0
        while True:
            jobs = effect_jobs()
            if not jobs:
                break
            try:
                if client is None:
                    client = orgb_connect()
                    primed.clear()
                for job in jobs:
                    if job["index"] not in primed:
                        client.set_custom_mode(job["index"])
                        primed.add(job["index"])
                    zone = client.controller(job["index"])["zones"][job["zone"]]
                    count = zone["leds_count"]
                    if not count:
                        continue
                    speed = max(1, min(100, job["speed"])) / 100.0
                    client.update_zone_leds(
                        job["index"], job["zone"],
                        effect_frame(job, count, phase * speed))
            except Exception:
                # Server restarted or went away: drop the connection and retry
                # on the next tick rather than dying.
                if client is not None:
                    client.close()
                client = None
                idle += 1.0
                if idle > 60:
                    break
                time.sleep(1.0)
                continue
            idle = 0.0
            phase = (phase + EFFECT_TICK / 4.0) % 1000.0
            time.sleep(EFFECT_TICK)
    return 0


ORGB_HOST = os.environ.get("OMAPERI_OPENRGB_HOST", "127.0.0.1")
ORGB_PORT = int(os.environ.get("OMAPERI_OPENRGB_PORT", "6742"))


def orgb_connect():
    return OpenRGB(ORGB_HOST, ORGB_PORT)


def zone_starts(zones):
    """First LED index of each zone; zones are laid out consecutively."""
    starts, at = [], 0
    for z in zones:
        starts.append(at)
        at += z["leds_count"]
    return starts


# --------------------------------------------------------------------------
# OpenRGB — anything OpenRGB sees (keyboards, motherboards, RAM, ...)
# --------------------------------------------------------------------------

ORGB_DEVICE_RE = re.compile(r"^(\d+):\s+(.*)$")


def orgb_available():
    try:
        orgb_connect().close()
        return True, None
    except Exception:
        pass
    if shutil.which("openrgb"):
        # Degraded: colour only, no zones, no readback, no resizing.
        return True, None
    return False, "openrgb not installed"


def parse_openrgb(text):
    """Parse `openrgb --list-devices` into dicts.

    Kept pure so it is testable without hardware; the bracketed mode is the
    active one.
    """
    devices = []
    current = None
    for line in text.splitlines():
        m = ORGB_DEVICE_RE.match(line)
        if m:
            current = {"index": int(m.group(1)), "name": m.group(2).strip(),
                       "type": "", "modes": [], "active_mode": None, "leds": 0}
            devices.append(current)
            continue
        if current is None:
            continue
        stripped = line.strip()
        if stripped.startswith("Type:"):
            current["type"] = stripped.split(":", 1)[1].strip()
        elif stripped.startswith("LEDs:"):
            current["leds"] = len(re.findall(r"'[^']*'", stripped))
        elif stripped.startswith("Modes:"):
            for token in stripped.split(":", 1)[1].split():
                if token.startswith("[") and token.endswith("]"):
                    token = token[1:-1]
                    current["active_mode"] = token
                current["modes"].append(token)
    return devices


# OpenRGB's own device types. Anything missing here still gets a tab, labelled
# with the type OpenRGB reported rather than a generic "Device".
ORGB_KIND = {
    "Motherboard": "motherboard",
    "DRAM": "memory",
    "GPU": "gpu",
    "Cooler": "cooler",
    "LEDStrip": "light",
    "Keyboard": "keyboard",
    "Mouse": "mouse",
    "MouseMat": "mousemat",
    "Headset": "headset",
    "HeadsetStand": "headset",
    "Gamepad": "gamepad",
    "Light": "light",
    "Speaker": "speaker",
    "Storage": "storage",
    "Case": "case",
    "Microphone": "microphone",
    "Keypad": "keyboard",
}


def orgb_devices():
    """Prefer the SDK; fall back to the CLI when no server is running.

    The CLI can only set a whole-device colour: it cannot report zones, read a
    colour back, or resize an addressable channel -- and an unsized channel is
    exactly why an ARGB header lights nothing.
    """
    try:
        with orgb_connect() as client:
            return [orgb_sdk_device(i, client.controller(i))
                    for i in range(client.controller_count())]
    except Exception:
        pass
    rc, out, _ = run(["openrgb", "--list-devices"], timeout=45)
    if rc != 0:
        return []
    return [orgb_device(d) for d in parse_openrgb(out)]


# OpenRGB's own device type enum, in order.
ORGB_TYPE_KIND = [
    "motherboard", "memory", "gpu", "cooler", "light", "keyboard", "mouse",
    "mousemat", "headset", "headset", "gamepad", "light", "speaker", "other",
    "storage", "case", "microphone", "other", "keyboard",
]


def orgb_sdk_device(index, d):
    dev_id = "openrgb:%d" % index
    zones = d["zones"]
    starts = zone_starts(zones)
    controls = []

    modes = [m["name"] for m in d["modes"]]
    if len(modes) > 1:
        active = modes[d["active_mode"]] if 0 <= d["active_mode"] < len(modes) else modes[0]
        controls.append(control("mode", "Mode", "enum", value=active,
                                options=[{"value": m, "label": m} for m in modes]))
    elif modes:
        controls.append(control("mode", "Mode", "readout", value=modes[0]))

    for zi, zone in enumerate(zones):
        resizable = zone["leds_max"] > zone["leds_min"]
        if resizable:
            # Nobody knows how many LEDs are on their fan header, and no
            # software can measure it -- the ARGB data line is one-way. So the
            # count is advanced-only; colouring a channel sizes it on demand.
            controls.append(
                control("zone%d_size" % zi, zone["name"] + " LEDs", "range",
                        min=zone["leds_min"], max=zone["leds_max"], step=1,
                        value=zone["leds_count"], editable=True, advanced=True)
            )
        if zone["leds_count"] or resizable:
            start = starts[zi]
            packed = d["colors"][start] if start < len(d["colors"]) else 0
            effect = remembered(dev_id, "zone%d_effect" % zi, "static")
            # While an effect runs the hardware colour changes every frame, so
            # reading it back would make the swatch flicker. Show the colour
            # the effect was seeded with instead.
            shown = (remembered(dev_id, "zone%d_color" % zi, "#00ff88")
                     if effect != "static" else "#%02x%02x%02x" % unrgb(packed))
            controls.append(
                control("zone%d_color" % zi, zone["name"] + " colour", "color",
                        value=shown)
            )
            controls.append(
                control("zone%d_effect" % zi, zone["name"] + " effect", "enum",
                        value=effect,
                        options=[{"value": e, "label": EFFECT_LABELS[e]}
                                 for e in EFFECTS])
            )
            if effect != "static":
                controls.append(
                    control("zone%d_speed" % zi, zone["name"] + " speed", "range",
                            min=1, max=100, step=1,
                            value=int(remembered(dev_id, "zone%d_speed" % zi, 50)))
                )

    note = None

    kind = ORGB_TYPE_KIND[d["type"]] if 0 <= d["type"] < len(ORGB_TYPE_KIND) else "other"
    return {
        "id": dev_id,
        "name": d["name"],
        "kind": kind,
        "type_label": None,
        "backend": "openrgb",
        "battery": None,
        "controls": controls,
        "note": note,
    }


def orgb_device(d):
        dev_id = "openrgb:%d" % d["index"]
        controls = []
        # A controller can expose zones while having no LEDs configured -- an
        # ARGB header whose strip length was never set is the usual case.
        # Sending it a colour lights nothing, but the accompanying mode change
        # still takes the header away from whatever was driving it, so the fans
        # simply go dark. Offer nothing rather than that.
        if d.get("leds"):
            controls.append(control("color", "Colour", "color",
                                    value=remembered(dev_id, "color", "#00ff88")))
        if len(d["modes"]) > 1:
            controls.insert(
                0,
                control("mode", "Mode", "enum",
                        options=[{"value": m, "label": m} for m in d["modes"]],
                        value=d["active_mode"] or d["modes"][0]),
            )
        elif d["modes"]:
            # A dropdown with one entry is a lie about having a choice. Most
            # OpenRGB keyboard protocols expose only Direct, meaning effects
            # have to be animated by software rather than the firmware.
            controls.insert(0, control("mode", "Mode", "readout", value=d["modes"][0]))
        return {
            "id": dev_id,
            "name": d["name"],
            "kind": ORGB_KIND.get(d["type"], "other"),
            # Carried so an unmapped type still reads as itself in the tab.
            "type_label": None if d["type"] in ORGB_KIND else (d["type"] or None),
            "backend": "openrgb",
            "battery": None,
            "controls": controls,
            "note": None if d.get("leds") else
                    "OpenRGB reports no configured LEDs for this controller. "
                    "Set its ARGB channel sizes in the OpenRGB app first; "
                    "colouring it from here would only switch the header away "
                    "from whatever is lighting it now.",
        }


def orgb_apply(dev, key, value):
    if key.startswith("zone") and ("_effect" in key or "_speed" in key):
        if "_effect" in key and value not in EFFECTS:
            raise SystemExit("no such effect: %s" % value)
        remember(dev["id"], key, value if "_effect" in key else int(value))
        if key.endswith("_effect") and value == "static":
            # Put the seeded colour back, or the strip keeps whatever frame the
            # writer left behind.
            zone_index = int(key[4:key.index("_")])
            colour = remembered(dev["id"], "zone%d_color" % zone_index, "#00ff88")
            orgb_sdk_apply(dev, "zone%d_color" % zone_index, colour)
        ensure_effects_daemon()
        return
    if key.startswith("zone") and ("_size" in key or "_color" in key):
        return orgb_sdk_apply(dev, key, value)
    index = dev["id"].split(":", 1)[1]
    remember(dev["id"], key, value)
    cmd = ["openrgb", "--device", index]
    if key == "color":
        cmd += ["--color", (value or "").lstrip("#")]
        mode = remembered(dev["id"], "mode")
        if mode:
            cmd += ["--mode", mode]
    elif key == "mode":
        cmd += ["--mode", str(value)]
        colour = remembered(dev["id"], "color")
        if colour:
            cmd += ["--color", colour.lstrip("#")]
    else:
        raise SystemExit("openrgb: no such control %r" % key)

    rc, _out, err = run(cmd, timeout=45)
    if rc != 0:
        raise SystemExit("openrgb failed: %s" % err.strip())


def orgb_sdk_apply(dev, key, value):
    index = int(dev["id"].split(":", 1)[1])
    zone_index = int(key[4:key.index("_")])
    with orgb_connect() as client:
        if key.endswith("_size"):
            client.resize_zone(index, zone_index, int(value))
            return
        zone = client.controller(index)["zones"][zone_index]
        count = zone["leds_count"]
        if not count:
            # Size it to the channel maximum rather than asking. The data line
            # is one-way so the length cannot be measured, but surplus colour
            # data is simply ignored by a shorter strip -- so the maximum
            # lights whatever is actually attached, and nothing is asked of
            # someone who has no idea how many LEDs their fans have.
            client.resize_zone(index, zone_index, zone["leds_max"])
            zone = client.controller(index)["zones"][zone_index]
            count = zone["leds_count"]
        if not count:
            raise SystemExit("%s could not be sized" % zone["name"])
        packed = rgb(*hex_to_rgb(value))
        # Direct/custom mode first, or the controller keeps running whatever
        # effect it was on and ignores the LED data.
        client.set_custom_mode(index)
        client.update_zone_leds(index, zone_index, [packed] * count)
    remember(dev["id"], key, value)


# --------------------------------------------------------------------------
# v4l2 — webcams
# --------------------------------------------------------------------------

V4L2_CTRL_RE = re.compile(
    r"^\s*(?P<name>\w+)\s+0x[0-9a-f]+\s+\((?P<type>\w+)\)\s*:\s*(?P<rest>.*)$"
)
V4L2_MENU_RE = re.compile(r"^\s+(?P<value>\d+):\s*(?P<label>.+?)\s*$")


def v4l2_available():
    if not shutil.which("v4l2-ctl"):
        return False, "v4l-utils not installed"
    return True, None


def parse_v4l2_controls(text):
    """Parse `v4l2-ctl --list-ctrls-menus` into uniform controls.

    Controls flagged inactive are dropped: they are the ones an automatic mode
    currently owns (exposure while auto-exposure is on), and writing them
    fails. Turn the automatic control off and they reappear on the next poll.
    """
    controls = []
    for line in text.splitlines():
        m = V4L2_CTRL_RE.match(line)
        if m:
            attrs = dict(
                re.findall(r"(\w+)=(-?\d+)", m.group("rest"))
            )
            flags = ""
            fm = re.search(r"flags=(.*)$", m.group("rest"))
            if fm:
                flags = fm.group(1)
            if "inactive" in flags or "read-only" in flags:
                continue
            ctype = m.group("type")
            name = m.group("name")
            label = name.replace("_", " ").capitalize()
            value = int(attrs["value"]) if "value" in attrs else None
            if ctype == "bool":
                controls.append(control(name, label, "toggle", value=bool(value)))
            elif ctype == "int":
                controls.append(
                    control(name, label, "range",
                            min=int(attrs.get("min", 0)), max=int(attrs.get("max", 100)),
                            step=int(attrs.get("step", 1)), value=value)
                )
            elif ctype == "menu":
                controls.append(control(name, label, "enum", options=[], value=value))
            continue

        mm = V4L2_MENU_RE.match(line)
        if mm and controls and controls[-1]["type"] == "enum":
            controls[-1]["options"].append(
                {"value": int(mm.group("value")), "label": mm.group("label")}
            )
    # A menu with no parsed entries would render as an empty dropdown.
    return [c for c in controls if c["type"] != "enum" or c.get("options")]


def v4l2_capture_nodes():
    """Only real capture nodes — uvcvideo also exposes a metadata node."""
    nodes = []
    for path in sorted(
        p for p in os.listdir("/dev") if re.fullmatch(r"video\d+", p)
    ):
        dev = "/dev/" + path
        rc, out, _ = run(["v4l2-ctl", "-d", dev, "--info"], timeout=10)
        if rc != 0:
            continue
        caps = out.split("Device Caps", 1)
        if len(caps) < 2 or "Video Capture" not in caps[1].split("Media Driver")[0]:
            continue
        name = "Webcam"
        nm = re.search(r"Card type\s*:\s*(.+)", out)
        if nm:
            name = nm.group(1).strip()
        nodes.append((dev, name))
    return nodes


def v4l2_devices():
    devices = []
    for dev, name in v4l2_capture_nodes():
        rc, out, _ = run(["v4l2-ctl", "-d", dev, "--list-ctrls-menus"], timeout=10)
        if rc != 0:
            continue
        controls = parse_v4l2_controls(out)
        if not controls:
            continue
        devices.append({
            "id": "v4l2:%s" % os.path.basename(dev),
            "name": name,
            "kind": "webcam",
            "backend": "v4l2",
            "battery": None,
            "controls": controls,
            "note": None,
        })
    return devices


def v4l2_apply(dev, key, value):
    node = "/dev/" + dev["id"].split(":", 1)[1]
    if isinstance(value, bool):
        value = 1 if value else 0
    if str(value).lower() in ("true", "false"):
        value = 1 if str(value).lower() == "true" else 0
    rc, _out, err = run(["v4l2-ctl", "-d", node, "-c", "%s=%s" % (key, value)])
    if rc != 0:
        raise SystemExit("v4l2-ctl %s=%s failed: %s" % (key, value, err.strip()))


# --------------------------------------------------------------------------
# dummy — every control type, no hardware
# --------------------------------------------------------------------------


def dummy_available():
    """Off unless OMAPERI_DUMMY=1, so it never shows up by accident."""
    if os.environ.get("OMAPERI_DUMMY") != "1":
        return False, "set OMAPERI_DUMMY=1 to enable"
    return True, None


def dummy_devices():
    dev_id = "dummy:0"
    return [{
        "id": dev_id,
        "name": "Dummy Thermal Widget",
        # Deliberately a kind omaperi does not map, to exercise the fallback.
        "kind": "other",
        "type_label": "Thermometer",
        "backend": "dummy",
        "battery": {"level": int(remembered(dev_id, "level", 55)), "charging": False},
        "controls": [
            control("level", "Level", "range", min=0, max=100, step=1,
                    unit="%", value=int(remembered(dev_id, "level", 55))),
            control("profile", "Profile", "enum", value=remembered(dev_id, "profile", "quiet"),
                    options=[{"value": "quiet", "label": "Quiet"},
                             {"value": "balanced", "label": "Balanced"},
                             {"value": "turbo", "label": "Turbo"}]),
            control("enabled", "Enabled", "toggle",
                    value=bool(remembered(dev_id, "enabled", True))),
            control("identify", "Identify", "action"),
            control("uptime", "Uptime", "readout", value="3d 4h"),
            control("color", "Colour", "color", value=remembered(dev_id, "color", "#00ff88")),
        ],
        "note": None,
    }]


def dummy_apply(dev, key, value):
    if key == "enabled":
        value = str(value).lower() in ("1", "true", "on", "yes")
    elif key == "level":
        value = int(value)
    remember(dev["id"], key, value)


# --------------------------------------------------------------------------
# adapter registry
# --------------------------------------------------------------------------

ADAPTERS = {
    "headsetcontrol": (hs_available, hs_devices, hs_apply),
    "openrazer": (razer_available, razer_devices, razer_apply),
    "openrgb": (orgb_available, orgb_devices, orgb_apply),
    "v4l2": (v4l2_available, v4l2_devices, v4l2_apply),
    "dummy": (dummy_available, dummy_devices, dummy_apply),
}

KIND_ORDER = ["headset", "mouse", "mousemat", "keyboard", "webcam", "microphone",
              "speaker", "gamepad", "light", "cooler", "case", "motherboard",
              "memory", "gpu", "storage", "other"]


def build_document():
    devices, backends = [], []
    for name, (available, enumerate_devices, _apply) in ADAPTERS.items():
        ok, reason = available()
        # The dummy is a development aid and is meant to be off, so listing it
        # as an inactive backend would read as something being wrong.
        if name != "dummy" or ok:
            backends.append({"name": name, "available": ok, "reason": reason})
        if not ok:
            continue
        try:
            devices.extend(enumerate_devices())
        except Exception as exc:  # one broken backend must not blank the panel
            backends[-1] = {"name": name, "available": False, "reason": str(exc)}
    devices.sort(key=lambda d: (KIND_ORDER.index(d["kind"])
                                if d["kind"] in KIND_ORDER else 99, d["name"]))
    return {"schema": SCHEMA, "devices": devices, "backends": backends}


def cached_document(max_age=None):
    """Poll under a lock, and serve a short cache.

    `max_age` defaults to CACHE_TTL. Pass float("inf") to accept a cached
    document of any age: apply only needs to know which backend owns the
    device, and it re-enumerates that backend immediately afterwards, so
    paying for a full rebuild first just makes the click slower.

    The bar instantiates one widget per monitor, so two polls can land at once;
    two concurrent headsetcontrol calls fight over the same HID device and both
    come back empty, which reads exactly like "device is off".
    """
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            age = time.time() - os.path.getmtime(CACHE)
            if 0 <= age < (CACHE_TTL if max_age is None else max_age):
                with open(CACHE) as f:
                    return json.load(f)
        except Exception:
            pass
        doc = build_document()
        tmp = CACHE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(doc, f)
        os.replace(tmp, CACHE)
        return doc


def write_cache(doc):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = CACHE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(doc, f)
    os.replace(tmp, CACHE)


def refresh_backend(doc, backend):
    """Re-enumerate one backend in place.

    A full rebuild after every click costs a re-enumeration of every backend,
    which is seconds -- clicks felt broken. Only the touched backend can have
    changed, and re-reading it is what makes dependent controls appear
    correctly (switching auto white balance off reveals the manual exposure
    control on the very next frame, not a minute later).
    """
    available, enumerate_devices, _apply = ADAPTERS[backend]
    ok, _reason = available()
    if not ok:
        return
    try:
        fresh = {d["id"]: d for d in enumerate_devices()}
    except Exception:
        return
    doc["devices"] = [
        fresh.get(d["id"], d) if d["backend"] == backend else d
        for d in doc["devices"]
    ]


def find_device(doc, device_id):
    for d in doc["devices"]:
        if d["id"] == device_id:
            return d
    raise SystemExit("no such device: %s" % device_id)


def find_control(dev, key):
    """Only keys the device actually advertises may be applied.

    Without this the key goes straight into the vendor command. v4l2-ctl -c
    takes a comma-separated list, so a crafted key could set controls that
    were never offered. Everything here runs as the user already, so this is
    robustness rather than a privilege boundary -- but a control that was not
    offered should not be settable.
    """
    for c in dev.get("controls", []):
        if c["key"] == key:
            return c
    raise SystemExit("%s has no control %r" % (dev["id"], key))


def main(argv):
    command = argv[1] if len(argv) > 1 else "status"

    if command == "status":
        json.dump(cached_document(), sys.stdout)
        sys.stdout.write("\n")
        return 0

    if command == "effects":
        return run_effects()

    if command == "backends":
        for b in build_document()["backends"]:
            mark = "ok" if b["available"] else "--"
            print("%s %-16s %s" % (mark, b["name"], b["reason"] or ""))
        return 0

    if command == "apply":
        if len(argv) < 5:
            raise SystemExit("usage: omaperi apply DEVICE_ID CONTROL VALUE")
        device_id, key, value = argv[2], argv[3], argv[4]
        doc = cached_document(max_age=float("inf"))
        dev = find_device(doc, device_id)
        control_spec = find_control(dev, key)
        if control_spec["type"] == "readout":
            raise SystemExit("%s/%s is read-only" % (device_id, key))
        ADAPTERS[dev["backend"]][2](dev, key, value)
        refresh_backend(doc, dev["backend"])
        write_cache(doc)
        json.dump(doc, sys.stdout)
        sys.stdout.write("\n")
        return 0

    raise SystemExit(__doc__.strip())


if __name__ == "__main__":
    sys.exit(main(sys.argv))
